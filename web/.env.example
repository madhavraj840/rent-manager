# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Put the same values in Vercel: Project -> Settings -> Environment Variables.

# Supabase -> Settings -> General (or the Connect button): https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase -> Settings -> API Keys -> Publishable key (sb_publishable_...). Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase -> Settings -> API Keys -> Secret keys (sb_secret_...). SERVER ONLY. Master key: never share it.
SUPABASE_SECRET_KEY=

# Supabase -> Connect -> Connection string -> "Transaction pooler" (port 6543). Used by the website.
DATABASE_URL=

# Supabase -> Connect -> Connection string -> "Session pooler" (port 5432). Used only to update the database tables.
DATABASE_URL_MIGRATE=

# Set to "on" only after you turn on Google in Supabase -> Authentication -> Sign In / Providers.
# Anything else (or missing) hides the "Continue with Google" button. Not a secret.
NEXT_PUBLIC_GOOGLE_SIGN_IN=
